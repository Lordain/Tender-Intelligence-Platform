# Supabase (see README.md "Database Setup" for how to obtain these)
# These two are safe to expose to the browser (required for client-side auth) —
# "Publishable key" in newer Supabase dashboards is the same thing as the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security — never expose to the client.
# "Secret keys" in newer Supabase dashboards is the same thing as the service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Data ingestion (see lib/ingestion/README.md — this is an unverified
# placeholder; confirm the real endpoint before setting it).
COMPRAS_MX_OCDS_API_URL=

# Layer 2 extraction (npm run extract:document — see
# lib/ingestion/extract-requirements.ts). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Admin panel (/admin/tenders — see lib/admin-auth.ts). Comma-separated
# email addresses allowed to add/edit/delete tenders. Unset or empty means
# NOBODY has access, not everyone — this must be set explicitly.
ADMIN_EMAILS=

# Transactional email and scheduled tender notifications. Keep notifications
# false until migration 0017 is applied and the scheduler is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL="拉美招投标信息平台 <updates@latintender.com>"
APP_URL=http://localhost:3000
EMAIL_NOTIFICATIONS_ENABLED=false
CRON_SECRET=

# Stripe subscriptions. Create one recurring Price for every plan/interval
# combination. APP_URL is used for Checkout success/cancel redirects.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated operational recipients. Falls back to ADMIN_EMAILS when
# omitted. Receives one email on a verified Stripe event processing failure
# and another when a later Stripe retry succeeds.
WEBHOOK_ALERT_EMAILS=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_SEMIANNUAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_SEMIANNUAL=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Billing support shown publicly on the pricing/account pages. WhatsApp must
# include the country code; punctuation is ignored (example: +52 55 ...).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BILLING_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Legal identity shown in the Terms and Privacy Notice. Mexican privacy law
# requires the controller's real legal name and domicile; do not deploy the
# placeholder values on a production legal notice.
# LEGAL_OPERATOR_ADDRESS unset omits the domicile clause entirely rather than
# printing a placeholder — intended only for pre-launch, while the operating
# company does not exist yet. Set it before the notice goes live.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=

# MXN charged for each displayed USD when a customer chooses SPEI bank
# transfer. Review before enabling transfers; the resulting Stripe invoice
# locks the amount for BANK_TRANSFER_DAYS_UNTIL_DUE days.
USD_MXN_BANK_TRANSFER_RATE=
BANK_TRANSFER_DAYS_UNTIL_DUE=3

# Optional international wire contact workflow outside Stripe. No receiving
# account details are stored or displayed by the website: staff verify the
# customer and provide them manually through an approved support channel.
INTERNATIONAL_WIRE_ENABLED=false

# Alibaba Cloud DashScope. REQUIRED for title/summary translation since
# 2026-09-08: npm run translate:tenders and the admin "翻译所有标题" button
# both run Qwen3.6-Plus through it (lib/ingestion/translate-titles-qwen.ts).
# Also read by npm run compare:translation / compare:extraction and by the
# Qwen extraction tiers in scripts/analyze-batch.ts.
DASHSCOPE_API_KEY=
