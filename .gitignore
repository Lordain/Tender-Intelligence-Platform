# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real downloaded tender documents (ingest-colombia-documents.ts) — never committed, and never served back to users (see that script's header comment)
/downloads/

# reclassify-tenders.ts's CSV exports of real (or locally-seeded) production data — never committed
/exports/

# Raw source captures kept at the repo root while building/debugging a
# connector — real DOF/CFE notice HTML, an OCDS release dump, a scratch
# export folder. They are evidence for one investigation, not code, and
# some run to megabytes; keeping them out of the tree stops a `git add -A`
# from committing a pile of them by accident. Nothing reads these paths.
/nota-*.html
/cfe-detail-test.html
/*.ndjson
/testProjects/
