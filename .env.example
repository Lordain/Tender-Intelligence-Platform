# Supabase (see README.md "Database Setup" for how to obtain these)
# These two are safe to expose to the browser (required for client-side auth) —
# "Publishable key" in newer Supabase dashboards is the same thing as the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security — never expose to the client.
# "Secret keys" in newer Supabase dashboards is the same thing as the service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Data ingestion (see lib/ingestion/README.md — this is an unverified
# placeholder; confirm the real endpoint before setting it).
COMPRAS_MX_OCDS_API_URL=

# Layer 2 extraction (npm run extract:document — see
# lib/ingestion/extract-requirements.ts). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
